package NOV_21.static_block;

public class StaticBlockDemo8 {
	final static int x; // Blank Final field
	static {
		m1();
		x = 15;
	}
	public static void m1 () {
		System.out.println("Default value of X is: "+x);
	}
	public static void main(String[]args) {
		System.out.println("After in initialization: "+StaticBlockDemo8.x);
	}

}
