package NOV_01.instance_block;

public class Customer {
	private double bill;
	public Customer() {
		bill = 100000;
		System.out.println(bill);
	}{
		bill = 1000;
		System.out.println(bill);
	}
	{
		bill = 2000;
		System.out.println(bill);
		
	}{
		bill = 3000;
		System.out.println(bill);
	}{
		bill = 4000;
		System.out.println(bill);
	}
	public static void main(String[] args) {
		new Customer();
	}

}
