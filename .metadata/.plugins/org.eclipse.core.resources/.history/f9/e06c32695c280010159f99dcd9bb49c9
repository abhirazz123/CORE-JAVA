package NOV_13.Hierarchical_Inheritance;
class Shape{
		protected  int x;
		public Shape(int x) {
			this.x = x;
		}
	}
class Circle extends Shape{
	final double  Pi = 3.14;
	public Circle(int redius) {
		super(redius);
	}
	public void AreaofCircle() {
		double area = Pi*x*x;
		System.out.println("Area of Circle : "+area);
	}
	
}
