package NOV_22.Dout_class_file_by_using_new_keyword;
class Demo {
	static int x = 10;
	static {
		System.out.println("static Block Of class Demo Class Executued!!: "+x);
	}
}

public class ClassLoading {
	public static void main(String[] args) {
		System.out.println("Main Method");
		new Demo();
		System.out.println(Demo.x);
	}

}
